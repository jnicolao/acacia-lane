# Copy this file to .env.local and fill it in. .env.local is never committed.

# Where the PickSpot API lives, ending in /api/v1. PickSpot gives you this
# address together with your API key. Needed for real orders; practice mode
# (npm run dev:practice) works without it.
PICKSPOT_API_URL=

# The shop's public web address. Optional: you can save it on the Settings
# page instead, and a saved address wins over this one.
PUBLIC_URL=

# The owner's password, asked for on the owner's pages anywhere but on this
# computer (localhost). Needed to manage a hosted shop. Pick a long one, and
# set it where the shop is hosted (on Vercel: Environment Variables).
ADMIN_PASSWORD=

# A Postgres database to keep the shop's data in, instead of files under
# .data/. Needed on Vercel and similar, where files do not last; Vercel sets it
# by itself when a Neon database is connected. Leave it out to use files.
DATABASE_URL=

# Practice mode: a pretend PickSpot, nothing leaves your computer.
# `npm run dev:practice` sets this for you; leave it out when hosting.
# PICKSPOT_MOCK=1
